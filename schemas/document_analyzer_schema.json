{
  "$defs": {
    "DewarpSchema": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "description": "'ok': the page was dewarped; 'rejected': the predicted correction looked broken, the page was not dewarped (the image may need to be retaken)",
          "title": "Status",
          "type": "string"
        },
        "reasons": {
          "description": "Failed checks when rejected, e.g. ['mask_iou', 'spacing']",
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "coordinate": {
          "description": "Coordinates of the results: 'dewarped' (the dewarped image) or 'photo' (the image before dewarping)",
          "title": "Coordinate",
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "[width, height] of the dewarped image (None when rejected)",
          "title": "Size"
        },
        "mask_iou": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "IoU of the predicted page grid and the predicted paper mask",
          "title": "Mask Iou"
        },
        "flipped_cells": {
          "description": "Share of predicted grid cells turned over",
          "title": "Flipped Cells",
          "type": "number"
        },
        "spacing_ratio": {
          "description": "Longest / median predicted grid edge",
          "title": "Spacing Ratio",
          "type": "number"
        },
        "outside": {
          "description": "Share of predicted grid nodes far outside the image",
          "title": "Outside",
          "type": "number"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Multi-page dewarper: index of this page among the pages found in the image (left to right, then top to bottom)",
          "title": "Page"
        },
        "num_pages": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Multi-page dewarper: number of pages found in the image (spread, receipts side by side, ...)",
          "title": "Num Pages"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Multi-page dewarper: page detection score",
          "title": "Score"
        }
      },
      "required": [
        "status",
        "reasons",
        "coordinate",
        "size",
        "mask_iou",
        "flipped_cells",
        "spacing_ratio",
        "outside"
      ],
      "title": "DewarpSchema",
      "type": "object"
    },
    "FigureSchema": {
      "additionalProperties": false,
      "properties": {
        "box": {
          "description": "Bounding box of the figure in the format [x1, y1, x2, y2]",
          "items": {
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Box",
          "type": "array"
        },
        "polygon": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Outline [[x, y], ...] in the photo before geometric correction, set only when the results were mapped back to it (box is then the outline's bounding box)",
          "title": "Polygon"
        },
        "order": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Order of the figure in the document",
          "title": "Order"
        },
        "paragraphs": {
          "description": "List of paragraphs associated with the figure",
          "items": {
            "$ref": "#/$defs/ParagraphSchema"
          },
          "title": "Paragraphs",
          "type": "array"
        },
        "direction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Text direction, e.g., ['horizontal' or 'vertical']",
          "title": "Direction"
        },
        "figure_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Relative path to the exported figure image from the output file",
          "title": "Figure Path"
        }
      },
      "required": [
        "box",
        "order",
        "paragraphs",
        "direction"
      ],
      "title": "FigureSchema",
      "type": "object"
    },
    "ParagraphSchema": {
      "additionalProperties": false,
      "properties": {
        "box": {
          "description": "Bounding box of the paragraph in the format [x1, y1, x2, y2]",
          "items": {
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Box",
          "type": "array"
        },
        "polygon": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Outline [[x, y], ...] in the photo before geometric correction, set only when the results were mapped back to it (box is then the outline's bounding box)",
          "title": "Polygon"
        },
        "contents": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Text content of the paragraph",
          "title": "Contents"
        },
        "direction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Text direction, e.g., ['horizontal' or 'vertical']",
          "title": "Direction"
        },
        "order": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Order of the paragraph in the document",
          "title": "Order"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Role of the paragraph, e.g., ['section_headings', 'page_header', 'page_footer'])",
          "title": "Role"
        }
      },
      "required": [
        "box",
        "contents",
        "direction",
        "order",
        "role"
      ],
      "title": "ParagraphSchema",
      "type": "object"
    },
    "PreprocessSchema": {
      "additionalProperties": false,
      "properties": {
        "dewarp": {
          "anyOf": [
            {
              "$ref": "#/$defs/DewarpSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Geometric correction result; None when it is disabled"
        }
      },
      "title": "PreprocessSchema",
      "type": "object"
    },
    "TableCellSchema": {
      "additionalProperties": false,
      "properties": {
        "col": {
          "description": "Column index of the cell",
          "title": "Col",
          "type": "integer"
        },
        "row": {
          "description": "Row index of the cell",
          "title": "Row",
          "type": "integer"
        },
        "col_span": {
          "description": "Number of columns spanned by the cell",
          "title": "Col Span",
          "type": "integer"
        },
        "row_span": {
          "description": "Number of rows spanned by the cell",
          "title": "Row Span",
          "type": "integer"
        },
        "box": {
          "description": "Bounding box of the cell in the format [x1, y1, x2, y2]",
          "items": {
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Box",
          "type": "array"
        },
        "polygon": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Outline [[x, y], ...] in the photo before geometric correction, set only when the results were mapped back to it (box is then the outline's bounding box)",
          "title": "Polygon"
        },
        "contents": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Text content of the cell",
          "title": "Contents"
        }
      },
      "required": [
        "col",
        "row",
        "col_span",
        "row_span",
        "box",
        "contents"
      ],
      "title": "TableCellSchema",
      "type": "object"
    },
    "TableLineSchema": {
      "additionalProperties": false,
      "properties": {
        "box": {
          "description": "Bounding box of the table line in the format [x1, y1, x2, y2]",
          "items": {
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Box",
          "type": "array"
        },
        "polygon": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Outline [[x, y], ...] in the photo before geometric correction, set only when the results were mapped back to it (box is then the outline's bounding box)",
          "title": "Polygon"
        },
        "score": {
          "description": "Confidence score of the table line detection",
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "box",
        "score"
      ],
      "title": "TableLineSchema",
      "type": "object"
    },
    "TableStructureRecognizerSchema": {
      "additionalProperties": false,
      "properties": {
        "box": {
          "description": "Bounding box of the table in the format [x1, y1, x2, y2]",
          "items": {
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Box",
          "type": "array"
        },
        "polygon": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Outline [[x, y], ...] in the photo before geometric correction, set only when the results were mapped back to it (box is then the outline's bounding box)",
          "title": "Polygon"
        },
        "n_row": {
          "description": "Number of rows in the table",
          "title": "N Row",
          "type": "integer"
        },
        "n_col": {
          "description": "Number of columns in the table",
          "title": "N Col",
          "type": "integer"
        },
        "rows": {
          "description": "List of table lines representing rows",
          "items": {
            "$ref": "#/$defs/TableLineSchema"
          },
          "title": "Rows",
          "type": "array"
        },
        "cols": {
          "description": "List of table lines representing columns",
          "items": {
            "$ref": "#/$defs/TableLineSchema"
          },
          "title": "Cols",
          "type": "array"
        },
        "spans": {
          "description": "List of table lines representing spans",
          "items": {
            "$ref": "#/$defs/TableLineSchema"
          },
          "title": "Spans",
          "type": "array"
        },
        "cells": {
          "description": "List of table cells",
          "items": {
            "$ref": "#/$defs/TableCellSchema"
          },
          "title": "Cells",
          "type": "array"
        },
        "order": {
          "description": "Order of the table in the document",
          "title": "Order",
          "type": "integer"
        }
      },
      "required": [
        "box",
        "n_row",
        "n_col",
        "rows",
        "cols",
        "spans",
        "cells",
        "order"
      ],
      "title": "TableStructureRecognizerSchema",
      "type": "object"
    },
    "WordPrediction": {
      "additionalProperties": false,
      "properties": {
        "points": {
          "description": "Bounding box of the word in the format [[x1, y1], [x2, y2], [x3, y3], [x4, y4]]",
          "items": {
            "items": {
              "type": "integer"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Points",
          "type": "array"
        },
        "polygon": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Outline [[x, y], ...] in the photo before geometric correction, set only when the results were mapped back to it (box is then the outline's bounding box)",
          "title": "Polygon"
        },
        "content": {
          "description": "Text content of the word",
          "title": "Content",
          "type": "string"
        },
        "direction": {
          "description": "Text direction, e.g., 'horizontal' or 'vertical'",
          "title": "Direction",
          "type": "string"
        },
        "rec_score": {
          "description": "Confidence score of the word recognition",
          "title": "Rec Score",
          "type": "number"
        },
        "det_score": {
          "description": "Confidence score of the word detection",
          "title": "Det Score",
          "type": "number"
        }
      },
      "required": [
        "points",
        "content",
        "direction",
        "rec_score",
        "det_score"
      ],
      "title": "WordPrediction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "preprocess": {
      "anyOf": [
        {
          "$ref": "#/$defs/PreprocessSchema"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Preprocessing information of the document (geometric correction); None when disabled"
    },
    "paragraphs": {
      "description": "List of detected paragraphs",
      "items": {
        "$ref": "#/$defs/ParagraphSchema"
      },
      "title": "Paragraphs",
      "type": "array"
    },
    "tables": {
      "description": "List of detected tables",
      "items": {
        "$ref": "#/$defs/TableStructureRecognizerSchema"
      },
      "title": "Tables",
      "type": "array"
    },
    "words": {
      "description": "List of recognized words",
      "items": {
        "$ref": "#/$defs/WordPrediction"
      },
      "title": "Words",
      "type": "array"
    },
    "figures": {
      "description": "List of detected figures",
      "items": {
        "$ref": "#/$defs/FigureSchema"
      },
      "title": "Figures",
      "type": "array"
    }
  },
  "required": [
    "paragraphs",
    "tables",
    "words",
    "figures"
  ],
  "title": "DocumentAnalyzerSchema",
  "type": "object"
}